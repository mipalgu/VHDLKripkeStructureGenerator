{"hierarchy":{"paths":[["doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures","doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing","doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile"]]},"sections":[],"metadata":{"roleHeading":"Initializer","title":"init(decoderName:numberOfElements:elementSize:)","role":"symbol","externalID":"s:11VHDLParsing8VHDLFileV20VHDLMemoryStructuresE11decoderName16numberOfElements11elementSizeACSgAA08VariableF0V_S2itcfc","modules":[{"relatedModules":["VHDLParsing"],"name":"VHDLMemoryStructures"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"decoderName","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"VariableName","kind":"typeIdentifier","preciseIdentifier":"s:11VHDLParsing12VariableNameV"},{"text":", ","kind":"text"},{"text":"numberOfElements","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"elementSize","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"symbolKind":"init","extendedModule":"VHDLParsing"},"variants":[{"paths":["\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile\/init(decodername:numberofelements:elementsize:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile\/init(decoderName:numberOfElements:elementSize:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"decoderName"},{"kind":"text","text":" "},{"kind":"internalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11VHDLParsing12VariableNameV","kind":"typeIdentifier","text":"VariableName"},{"kind":"text","text":", "},{"kind":"externalParam","text":"numberOfElements"},{"kind":"text","text":" "},{"kind":"internalParam","text":"elements"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"elementSize"},{"kind":"text","text":" "},{"kind":"internalParam","text":"size"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}]}]},{"kind":"parameters","parameters":[{"name":"name","content":[{"type":"paragraph","inlineContent":[{"text":"The name of the decoder.","type":"text"}]}]},{"name":"elements","content":[{"inlineContent":[{"text":"The number of elements in the decoder.","type":"text"}],"type":"paragraph"}]},{"name":"size","content":[{"inlineContent":[{"text":"The size of each element in the decoder.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This initialiser creates a 32-bit decoder that assumes each element within the encoded 32-bit value"},{"type":"text","text":" "},{"type":"text","text":"contains an enable bit at it’s suffix. For example, the element "},{"type":"codeVoice","code":"\"0110\""},{"type":"text","text":" of length 4-bits would be"},{"type":"text","text":" "},{"type":"text","text":"immediately followed by a 1-bit enable bit "},{"type":"codeVoice","code":"'1'"},{"type":"text","text":". The "},{"type":"codeVoice","code":"elementSize"},{"type":"text","text":" parameter should ignore this"},{"type":"text","text":" "},{"type":"text","text":"enable bit when calculating the size of each element."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider a 32-bit encoded value with 2 elements"},{"type":"text","text":" "},{"type":"text","text":"each of size 4-bits. The encoded value may be: "},{"code":"\"11011000110000000000000000000000\"","type":"codeVoice"},{"type":"text","text":". The first element"},{"type":"text","text":" "},{"type":"text","text":"is "},{"code":"\"1101","type":"codeVoice"},{"type":"text","text":" with enable bit "},{"code":"'1'","type":"codeVoice"},{"type":"text","text":", and the second element is "},{"code":"\"0001\"","type":"codeVoice"},{"type":"text","text":" with enable bit "},{"code":"'1'","type":"codeVoice"},{"type":"text","text":". All other"},{"type":"text","text":" "},{"type":"text","text":"entries are padding. The decoder will contain a "},{"code":"data","type":"codeVoice"},{"type":"text","text":" input and 4 outputs named "},{"code":"out0","type":"codeVoice"},{"type":"text","text":", "},{"code":"out0en","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"out1","type":"codeVoice"},{"type":"text","text":", and "},{"code":"out1en","type":"codeVoice"},{"type":"text","text":" representing the decoded elements and their enable bits respectively. Please note"},{"type":"text","text":" "},{"type":"text","text":"that the element starting at the most-significant bit of the encoded value is considered element 0."}]},{"type":"aside","style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"numberOfElements"},{"type":"text","text":" and "},{"type":"codeVoice","code":"elementSize"},{"type":"text","text":" parameters must be greater than 0 and fit within"},{"type":"text","text":" "},{"type":"text","text":"a 32-bit encoded value."}]}]}]}],"kind":"symbol","abstract":[{"text":"Create a generic decoder.","type":"text"}],"references":{"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures":{"type":"topic","url":"\/documentation\/vhdlmemorystructures","abstract":[],"kind":"symbol","identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures","title":"VHDLMemoryStructures","role":"collection"},"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing":{"title":"VHDLParsing","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing","url":"\/documentation\/vhdlmemorystructures\/vhdlparsing","abstract":[]},"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing/VHDLFile/init(decoderName:numberOfElements:elementSize:)":{"url":"\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile\/init(decodername:numberofelements:elementsize:)","title":"init(decoderName:numberOfElements:elementSize:)","role":"symbol","type":"topic","identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile\/init(decoderName:numberOfElements:elementSize:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"decoderName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"VariableName","preciseIdentifier":"s:11VHDLParsing12VariableNameV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"numberOfElements"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"elementSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Create a generic decoder."}]},"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing/VHDLFile":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VHDLFile","kind":"identifier","preciseIdentifier":"s:11VHDLParsing8VHDLFileV"}],"navigatorTitle":[{"text":"VHDLFile","kind":"identifier"}],"type":"topic","url":"\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile","abstract":[{"text":"Create a generic decoder.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile","title":"VHDLFile","role":"symbol"}}}