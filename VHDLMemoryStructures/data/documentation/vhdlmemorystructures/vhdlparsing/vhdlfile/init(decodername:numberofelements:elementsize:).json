{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile\/init(decoderName:numberOfElements:elementSize:)"},"abstract":[{"type":"text","text":"Create a generic decoder."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile\/init(decodername:numberofelements:elementsize:)"]}],"hierarchy":{"paths":[["doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures","doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing","doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"decoderName"},{"kind":"text","text":" "},{"kind":"internalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11VHDLParsing12VariableNameV","text":"VariableName"},{"kind":"text","text":", "},{"kind":"externalParam","text":"numberOfElements"},{"kind":"text","text":" "},{"kind":"internalParam","text":"elements"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"elementSize"},{"kind":"text","text":" "},{"kind":"internalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The name of the decoder."}],"type":"paragraph"}],"name":"name"},{"content":[{"inlineContent":[{"text":"The number of elements in the decoder.","type":"text"}],"type":"paragraph"}],"name":"elements"},{"content":[{"inlineContent":[{"type":"text","text":"The size of each element in the decoder."}],"type":"paragraph"}],"name":"size"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This initialiser creates a 32-bit decoder that assumes each element within the encoded 32-bit value","type":"text"},{"text":" ","type":"text"},{"text":"contains an enable bit at it’s suffix. For example, the element ","type":"text"},{"code":"\"0110\"","type":"codeVoice"},{"text":" of length 4-bits would be","type":"text"},{"text":" ","type":"text"},{"text":"immediately followed by a 1-bit enable bit ","type":"text"},{"code":"'1'","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"elementSize","type":"codeVoice"},{"text":" parameter should ignore this","type":"text"},{"text":" ","type":"text"},{"text":"enable bit when calculating the size of each element.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, consider a 32-bit encoded value with 2 elements"},{"type":"text","text":" "},{"type":"text","text":"each of size 4-bits. The encoded value may be: "},{"type":"codeVoice","code":"\"11011000110000000000000000000000\""},{"type":"text","text":". The first element"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"\"1101"},{"type":"text","text":" with enable bit "},{"type":"codeVoice","code":"'1'"},{"type":"text","text":", and the second element is "},{"type":"codeVoice","code":"\"0001\""},{"type":"text","text":" with enable bit "},{"type":"codeVoice","code":"'1'"},{"type":"text","text":". All other"},{"type":"text","text":" "},{"type":"text","text":"entries are padding. The decoder will contain a "},{"type":"codeVoice","code":"data"},{"type":"text","text":" input and 4 outputs named "},{"type":"codeVoice","code":"out0"},{"type":"text","text":", "},{"type":"codeVoice","code":"out0en"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"out1"},{"type":"text","text":", and "},{"type":"codeVoice","code":"out1en"},{"type":"text","text":" representing the decoded elements and their enable bits respectively. Please note"},{"type":"text","text":" "},{"type":"text","text":"that the element starting at the most-significant bit of the encoded value is considered element 0."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"numberOfElements","type":"codeVoice"},{"type":"text","text":" and "},{"code":"elementSize","type":"codeVoice"},{"type":"text","text":" parameters must be greater than 0 and fit within"},{"type":"text","text":" "},{"type":"text","text":"a 32-bit encoded value."}]}],"style":"warning","name":"Warning","type":"aside"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"metadata":{"roleHeading":"Initializer","externalID":"s:11VHDLParsing8VHDLFileV20VHDLMemoryStructuresE11decoderName16numberOfElements11elementSizeACSgAA08VariableF0V_S2itcfc","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"decoderName"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11VHDLParsing12VariableNameV","kind":"typeIdentifier","text":"VariableName"},{"kind":"text","text":", "},{"kind":"externalParam","text":"numberOfElements"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"elementSize"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}],"extendedModule":"VHDLParsing","modules":[{"name":"VHDLMemoryStructures","relatedModules":["VHDLParsing"]}],"title":"init(decoderName:numberOfElements:elementSize:)","role":"symbol","symbolKind":"init"},"references":{"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing/VHDLFile/init(decoderName:numberOfElements:elementSize:)":{"identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/V