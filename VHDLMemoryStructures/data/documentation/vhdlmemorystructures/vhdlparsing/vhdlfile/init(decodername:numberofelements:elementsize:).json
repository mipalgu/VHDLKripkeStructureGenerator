on","type":"topic","url":"\/documentation\/vhdlmemorystructures\/vhdlparsing","kind":"symbol","title":"VHDLParsing","identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing","abstract":[]}}}