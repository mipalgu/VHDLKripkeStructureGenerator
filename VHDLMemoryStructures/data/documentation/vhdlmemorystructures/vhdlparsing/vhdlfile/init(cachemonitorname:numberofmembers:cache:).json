{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile\/init(cacheMonitorName:numberOfMembers:cache:)"},"metadata":{"extendedModule":"VHDLParsing","role":"symbol","roleHeading":"Initializer","modules":[{"name":"VHDLMemoryStructures","relatedModules":["VHDLParsing"]}],"symbolKind":"init","externalID":"s:11VHDLParsing8VHDLFileV20VHDLMemoryStructuresE16cacheMonitorName15numberOfMembers0E0ACSgAA08VariableG0V_SiAA6EntityVtcfc","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"cacheMonitorName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11VHDLParsing12VariableNameV","text":"VariableName"},{"kind":"text","text":", "},{"kind":"externalParam","text":"numberOfMembers"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11VHDLParsing6EntityV","text":"Entity"},{"kind":"text","text":")"}],"title":"init(cacheMonitorName:numberOfMembers:cache:)"},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Create a "},{"code":"VHDL","type":"codeVoice"},{"type":"text","text":" file for a cache monitor."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"init","kind":"keyword"},{"text":"?(","kind":"text"},{"text":"cacheMonitorName","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"name","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11VHDLParsing12VariableNameV","text":"VariableName","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"numberOfMembers","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"members","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"cache","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11VHDLParsing6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":")","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"name","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the monitor."}]}]},{"name":"members","content":[{"inlineContent":[{"text":"The number of entities that have access to the cache.","type":"text"}],"type":"paragraph"}]},{"name":"cache","content":[{"inlineContent":[{"type":"text","text":"The cache this monitor is managing."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A cache monitor is a file that arbitrates access to a cache when multiple entities are trying to"},{"type":"text","text":" "},{"type":"text","text":"access it simultaneously. The cache monitor adopts a round-robin schedule to determine which entity"},{"type":"text","text":" "},{"type":"text","text":"has access to the cache at any point in time. This schedule is not strictly enforced by the monitor"},{"type":"text","text":" "},{"type":"text","text":"but instead requires each entity to relinquish access to move onto the next entity. This design"},{"type":"text","text":" "},{"type":"text","text":"ensures a lightweight implementation that does not require a central arbiter to manage priorities and"},{"type":"text","text":" "},{"type":"text","text":"timeout requirements or adopt time-based scheduling windows that can create inefficient access. This"},{"type":"text","text":" "},{"type":"text","text":"does, however, require all entites to be aware of this fact and relinquish access when not using the"},{"type":"text","text":" "},{"type":"text","text":"cache as continuous access can result in starvation for all other entities."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To request access to the cache, an entity must assert the "},{"type":"codeVoice","code":"ready"},{"type":"text","text":" signal "},{"type":"codeVoice","code":"high"},{"type":"text","text":" at the start and"},{"type":"text","text":" "},{"type":"text","text":"during the entire operation of the cache. The cache monitor will assert the appropriate "},{"type":"codeVoice","code":"en"},{"type":"text","text":" signal"},{"type":"text","text":" "},{"type":"text","text":"(en0, en1, en2, etc.) to signify which entity has access to the cache at each point in time. The"},{"type":"text","text":" "},{"type":"codeVoice","code":"value"},{"type":"text","text":" and "},{"type":"codeVoice","code":"value_en"},{"type":"text","text":" signals are shared between all entities but only represent valid data for a"},{"type":"text","text":" "},{"type":"text","text":"specific entity when their respective "},{"type":"codeVoice","code":"en"},{"type":"text","text":" is "},{"type":"codeVoice","code":"high"},{"type":"text","text":"."}]}]}],"hierarchy":{"paths":[["doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures","doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing","doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile\/init(cachemonitorname:numberofmembers:cache:)"]}],"references":{"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing/VHDLFile":{"navigatorTitle":[{"kind":"identifier","text":"VHDLFile"}],"url":"\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile","title":"VHDLFile","abstract":[{"type":"text","text":"Create a generic decoder."}],"identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11VHDLParsing8VHDLFileV","kind":"identifier","text":"VHDLFile"}],"kind":"symbol"},"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing/VHDLFile/init(cacheMonitorName:numberOfMembers:cache:)":{"abstract":[{"text":"Create a ","type":"text"},{"type":"codeVoice","code":"VHDL"},{"text":" file for a cache monitor.","type":"text"}],"identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile\/init(cacheMonitorName:numberOfMembers:cache:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"cacheMonitorName","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"VariableName","kind":"typeIdentifier","preciseIdentifier":"s:11VHDLParsing12VariableNameV"},{"text":", ","kind":"text"},{"text":"numberOfMembers","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"cache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11VHDLParsing6EntityV"},{"text":")","kind":"text"}],"kind":"symbol","url":"\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile\/init(cachemonitorname:numberofmembers:cache:)","type":"topic","title":"init(cacheMonitorName:numberOfMembers:cache:)"},"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing":{"role":"collection","type":"topic","abstract":[],"title":"VHDLParsing","identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing","kind":"symbol","url":"\/documentation\/vhdlmemorystructures\/vhdlparsing"},"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures":{"identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures","url":"\/documentation\/vhdlmemorystructures","abstract":[],"type":"topic","kind":"symbol","role":"collection","title":"VHDLMemoryStructures"}}}