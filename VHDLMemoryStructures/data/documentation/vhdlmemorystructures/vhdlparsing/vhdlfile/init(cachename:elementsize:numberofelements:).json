{"metadata":{"role":"symbol","roleHeading":"Initializer","extendedModule":"VHDLParsing","externalID":"s:11VHDLParsing8VHDLFileV20VHDLMemoryStructuresE9cacheName11elementSize16numberOfElementsACSgAA08VariableF0V_S2itcfc","title":"init(cacheName:elementSize:numberOfElements:)","symbolKind":"init","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"cacheName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"VariableName","preciseIdentifier":"s:11VHDLParsing12VariableNameV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"elementSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"numberOfElements"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"modules":[{"relatedModules":["VHDLParsing"],"name":"VHDLMemoryStructures"}]},"variants":[{"paths":["\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile\/init(cachename:elementsize:numberofelements:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile\/init(cacheName:elementSize:numberOfElements:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures","doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing","doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Create a cache of elements that may be mapped to underlying BRAM structures."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"cacheName"},{"kind":"text","text":" "},{"kind":"internalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"VariableName","preciseIdentifier":"s:11VHDLParsing12VariableNameV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"elementSize"},{"kind":"text","text":" "},{"kind":"internalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"numberOfElements"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"name","content":[{"inlineContent":[{"type":"text","text":"The name of the cache."}],"type":"paragraph"}]},{"name":"size","content":[{"type":"paragraph","inlineContent":[{"text":"The size of the elements stored within the cache.","type":"text"}]}]},{"name":"numberOfElements","content":[{"inlineContent":[{"type":"text","text":"The number of elements to store in the cache."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This initialiser creates a cache of elements that may be smaller than 32-bits and therefore needs to"},{"type":"text","text":" "},{"type":"text","text":"be encoded into an appropriate 32-bit aligned memory structure. The interface of the cache hides the"},{"type":"text","text":" "},{"type":"text","text":"underlying mapping into BRAM and instead provides addresses based on the specific element rather"},{"type":"text","text":" "},{"type":"text","text":"than the underlying memory address. For example, 3 elements each 4 bits are addresses as element 0, 1,"},{"type":"text","text":" "},{"type":"text","text":"and 2 respectively rather than sharing address 0 within a 32-bit aligned memory space."}]},{"type":"paragraph","inlineContent":[{"text":"The entity of this cache is defined based on element size and reachable address space based on the","type":"text"},{"text":" ","type":"text"},{"text":"number of elements. An entity with 12 3-bit elements may look like the example below:","type":"text"}]},{"type":"codeListing","code":["entity Cache is","    port(","        clk: in std_logic;","        address: in std_logic_vector(3 downto 0);","        data: in std_logic_vector(2 downto 0);","        we: in std_logic;","        ready: in std_logic;","        busy: out std_logic;","        value: out std_logic_vector(2 downto 0);","        value_en: out std_logic;","        lastAddress: out std_logic_vector(3 downto 0)","    );","end Cache;"],"syntax":"VHDL"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each element within the cache is encoded together with an enable bit that indicates whether the"},{"type":"text","text":" "},{"type":"text","text":"element is present or not. This allows the cache to be partially filled and the enable bit to be used"},{"type":"text","text":" "},{"type":"text","text":"to determine which elements are within the dangling memory space. Read and write operations are"},{"type":"text","text":" "},{"type":"text","text":"supported through a "},{"type":"codeVoice","code":"we"},{"type":"text","text":" (write enable) bit that is "},{"type":"codeVoice","code":"high"},{"type":"text","text":" when writing and "},{"type":"codeVoice","code":"low"},{"type":"text","text":" when reading. The"},{"type":"text","text":" "},{"type":"codeVoice","code":"value"},{"type":"text","text":" output describes the current element at the given address and is paired with "},{"type":"codeVoice","code":"value_en"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"indicate whether an element exists at the given address. The "},{"type":"codeVoice","code":"data"},{"type":"text","text":" signal specifies the"},{"type":"text","text":" "},{"type":"text","text":"new data to be written to the cache when "},{"type":"codeVoice","code":"we"},{"type":"text","text":" is "},{"type":"codeVoice","code":"high"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"To perform a write, the write ","type":"text"},{"code":"address","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"data`` is set with the new element and the ","type":"codeVoice"},{"text":"we","type":"text"},{"code":"and","type":"codeVoice"},{"text":"ready","type":"text"},{"code":"signals are set","type":"codeVoice"},{"text":"high","type":"text"},{"code":". The write will only be initiated when the ","type":"codeVoice"},{"text":"busy","type":"text"},{"code":"signal is","type":"codeVoice"},{"text":"low","type":"text"},{"code":". When a write happens, the ","type":"codeVoice"},{"text":"busy","type":"text"},{"code":"signal will go","type":"codeVoice"},{"text":"high","type":"text"},{"code":"until the write is complete. The","type":"codeVoice"},{"text":"lastAddress`","type":"text"},{"text":" ","type":"text"},{"text":"signal will contain the address of the last element in the cache.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To perform a read, the address signal is set to the read address, the "},{"code":"we","type":"codeVoice"},{"type":"text","text":" signal is set "},{"code":"low","type":"codeVoice"},{"type":"text","text":" and the"},{"type":"text","text":" "},{"code":"ready","type":"codeVoice"},{"type":"text","text":" signal is set "},{"code":"high","type":"codeVoice"},{"type":"text","text":". The read will only be performed when the "},{"code":"busy","type":"codeVoice"},{"type":"text","text":" signal is "},{"code":"low","type":"codeVoice"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"read will take exactly 1 clock cycle to finish and will not change the "},{"code":"busy","type":"codeVoice"},{"type":"text","text":" signal during the"},{"type":"text","text":" "},{"type":"text","text":"operation. The "},{"code":"value","type":"codeVoice"},{"type":"text","text":" signal will contain the element at the given address and the "},{"code":"value_en","type":"codeVoice"},{"type":"text","text":" signal"},{"type":"text","text":" "},{"type":"text","text":"will be "},{"code":"high","type":"codeVoice"},{"type":"text","text":" if the element is present and "},{"code":"low","type":"codeVoice"},{"type":"text","text":" if the element is not present."}]},{"type":"paragraph","inlineContent":[{"text":"During the operation of the cache, any detected errors will cause a permanent ","type":"text"},{"code":"busy","type":"codeVoice"},{"text":" signal blocking","type":"text"},{"text":" ","type":"text"},{"text":"all further use of the cache.","type":"text"}]},{"type":"aside","style":"warning","name":"Warning","content":[{"inlineContent":[{"text":"Please ensure ","type":"text"},{"code":"elementSize","type":"codeVoice"},{"text":" is less than or equal to 30 bits as large elements are","type":"text"},{"text":" ","type":"text"},{"text":"currently not supported and will cause the program to crash.","type":"text"}],"type":"paragraph"}]}]}],"sections":[],"kind":"symbol","references":{"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures":{"type":"topic","url":"\/documentation\/vhdlmemorystructures","abstract":[],"kind":"symbol","identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures","title":"VHDLMemoryStructures","role":"collection"},"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing":{"title":"VHDLParsing","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing","url":"\/documentation\/vhdlmemorystructures\/vhdlparsing","abstract":[]},"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing/VHDLFile/init(cacheName:elementSize:numberOfElements:)":{"abstract":[{"type":"text","text":"Create a cache of elements that may be mapped to underlying BRAM structures."}],"kind":"symbol","url":"\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile\/init(cachename:elementsize:numberofelements:)","role":"symbol","title":"init(cacheName:elementSize:numberOfElements:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"cacheName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11VHDLParsing12VariableNameV","text":"VariableName"},{"kind":"text","text":", "},{"kind":"externalParam","text":"elementSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"numberOfElements"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile\/init(cacheName:elementSize:numberOfElements:)","type":"topic"},"doc://VHDLMemoryStructures/documentation/VHDLMemoryStructures/VHDLParsing/VHDLFile":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VHDLFile","kind":"identifier","preciseIdentifier":"s:11VHDLParsing8VHDLFileV"}],"navigatorTitle":[{"text":"VHDLFile","kind":"identifier"}],"type":"topic","url":"\/documentation\/vhdlmemorystructures\/vhdlparsing\/vhdlfile","abstract":[{"text":"Create a generic decoder.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/VHDLMemoryStructures\/documentation\/VHDLMemoryStructures\/VHDLParsing\/VHDLFile","title":"VHDLFile","role":"symbol"}}}